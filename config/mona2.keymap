#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/anti_idle_mode.dtsi>
#include <dt-bindings/anti_idle_mode.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 4
#define SCROLL 5

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    anti_idle {
        compatible = "zmk,anti-idle-generic";
        interval-ms = <60000>;              // 実行間隔（ms）
        // bindings = <&mmv MOVE_DOWN &mmv MOVE_UP>;

        bindings = <&kp RSFT>;   // 右Shiftを軽く押すなど
        tap_ms = <40>;                      // 各動作の押し時間
        wait_ms = <200>;                    // 動作間の待ち時間
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <1 2>;
        };

        jp {
            bindings = <&to 2>;
            key-positions = <38 37>;
        };

        us {
            bindings = <&to 0>;
            key-positions = <37 36>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            #bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                      &kp Y      &kp U  &lt 5 I    &kp O    &kp P
&mt LCTRL A       &kp S         &kp D         &kp F        &kp G                       &kp MINUS      &kp H      &kp J  &kp K      &kp L    &kp SINGLE_QUOTE
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B        &kp COLON      &kp SEMICOLON  &kp N      &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 7 LANG2  &lt 1 SPACE  &lt 6 LANG1    &kp BACKSPACE  &kp ENTER                             &mt RCTRL DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        US_NUM {
            bindings = <
&kp MINUS                &kp NUMBER_7   &kp NUMBER_8      &kp NUMBER_9  &kp PLUS                                   &kp EXCLAMATION  &kp AT_SIGN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND
&kp SLASH                &kp NUMBER_4   &kp NUMBER_5      &kp NUMBER_6  &kp ASTERISK               &kp UNDERSCORE  &kp HASH         &kp DOLLAR   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DOUBLE_QUOTES
&mt LEFT_SHIFT NUMBER_0  &kp NUMBER_1   &kp NUMBER_2      &kp NUMBER_3  &kp PERIOD    &kp EQUAL    &kp TILDE       &kp PERCENT      &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp QUESTION
&trans                   &kp LESS_THAN  &kp GREATER_THAN  &trans        &trans        &trans       &kp BACKSLASH   &kp GRAVE                                                                  &kp PIPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        JP_Symbols {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                          &trans  &trans  &lt 5 I  &trans  &trans
&trans  &trans  &trans  &trans  &trans                           &trans         &trans  &trans  &trans   &trans  &kp LA(N7)
&trans  &trans  &trans  &trans  &trans       &kp SINGLE_QUOTE    &kp SEMICOLON  &trans  &trans  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &lt 3 SPACE  &trans              &trans         &trans                           &trans
            >;
        };

        JP_NUM {
            bindings = <
&kp MINUS                &kp NUMBER_7   &kp NUMBER_8    &kp NUMBER_9  &kp LS(SEMICOLON)                             &kp LS(NUMBER_1)    &kp LEFT_BRACKET  &kp LS(NUMBER_8)       &kp LS(NUMBER_9)     &kp LS(NUMBER_6)
&kp SLASH                &kp NUMBER_4   &kp NUMBER_5    &kp NUMBER_6  &kp LS(SQT)                         &trans    &kp LS(NUMBER_3)    &kp LS(NUMBER_4)  &kp RIGHT_BRACKET      &kp NUHS             &kp LS(NUMBER_2)
&mt LEFT_SHIFT NUMBER_0  &kp NUMBER_1   &kp NUMBER_2    &kp NUMBER_3  &kp PERIOD         &kp LS(MINUS)    &trans    &kp LS(NUMBER_5)    &kp EQUAL         &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)  &kp LS(SLASH)
&trans                   &kp LS(COMMA)  &kp LS(PERIOD)  &trans        &trans             &trans           &kp INT1  &kp LS(LEFT_BRACE)                                                                &kp LS(INTERNATIONAL_3)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&kp A   &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &kp PAGE_DOWN    &kp UP_ARROW  &kp PAGE_UP      &kp HOME                              &trans          &trans          &trans        &trans           &trans
&kp TAB     &kp LEFT_ARROW   &kp DOWN      &kp RIGHT_ARROW  &kp END                  &trans       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans      &kp LC(LS(TAB))  &kp LC(TAB)   &kp LS(TAB)      &trans    &kp LG(TAB)    &kp RG(TAB)  &trans          &trans          &trans        &trans           &trans
&trans      &trans           &trans        &trans           &trans    &trans         &trans       &trans                                                         &trans
            >;
        };

        FUNK_BT {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                &kp F1        &kp F2  &kp F3  &kp F4  &kp F5
&trans          &trans        &trans        &trans        &trans                         &trans       &kp F6        &kp F7  &kp F8  &kp F9  &kp F10
&bt BT_CLR      &trans        &trans        &trans        &trans        &kp LS(LG(S))    &trans       &trans        &trans  &trans  &trans  &kp F11
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans           &aim AIM_ON  &aim AIM_OFF                          &kp F12
            >;
        };
    };
};
